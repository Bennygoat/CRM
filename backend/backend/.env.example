# Copy this file to .env in the same folder and fill in the values. .env is git-ignored; keep only variable names here.
# See README for how to generate the values.
# Used by the backend (Spring) and by docker compose (--env-file backend/backend/.env).

# JWT signing key: Base64 of 32 random bytes (required)
JWT_SECRET=

# MySQL account for the app (required). Username must not be root
DB_USERNAME=crm_app
DB_PASSWORD=

# Initial password of the built-in "admin" account. Only used when that account does not exist yet.
# Leave empty to skip creating it
ADMIN_INITIAL_PASSWORD=

# ECPay sandbox credentials (optional). Use the public test values from ECPay's developer docs.
# Never put production credentials in this file or in the repo
ECPAY_AIO_MERCHANT_ID=
ECPAY_AIO_HASH_KEY=
ECPAY_AIO_HASH_IV=
ECPAY_LOGISTICS_MERCHANT_ID=
ECPAY_LOGISTICS_HASH_KEY=
ECPAY_LOGISTICS_HASH_IV=
